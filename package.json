{
  "name": "dsh-stg-learning",
  "version": "0.1.3",
  "description": "DSH 内的 STG 学习工作区与学习会话管理插件",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/build.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "url": "https://github.com/wildcat430524/dsh-stg-learning.git",
    "type": "git"
  },
  "homepage": "https://github.com/wildcat430524/dsh-stg-learning"
}
