{
  "name": "dsh-stg-learning",
  "version": "0.5.16",
  "description": "DSH 原生 STG 学习工作台：课程、文档、作答、复习与导师会话",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "vendor",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "VERIFICATION.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "prepack": "npm run build",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "node scripts/serve-teacher.mjs",
    "capture:reader": "node scripts/capture-reader-visual.mjs",
    "test:reader": "node scripts/verify-reader-cdp.mjs",
    "test:browser": "node scripts/run-browser-checks.mjs",
    "test:native": "node scripts/verify-native.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.1-rc.2",
    "@floating-ui/dom": "1.8.0",
    "esbuild": "^0.27.0",
    "motion": "14.6.0",
    "postcss": "8.5.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "semver": "7.8.5"
  },
  "repository": {
    "url": "https://github.com/wildcat430524/dsh-stg-learning.git",
    "type": "git"
  },
  "homepage": "https://github.com/wildcat430524/dsh-stg-learning",
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "dompurify": "3.2.7",
    "highlight.js": "11.12.0",
    "katex": "0.16.22",
    "markdown-it": "14.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "*",
    "@deepseek-ai/dsh-persona": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-time-context": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-fs-search": "*",
    "@deepseek-ai/dsh-tool-skill": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-instructions": {
      "optional": true
    },
    "@deepseek-ai/dsh-persona": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-time-context": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-fs-search": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-skill": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5 || 0.2.2-rc.1"
  }
}
